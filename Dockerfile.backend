# Multi-stage build for Spring Boot application
FROM maven:3.9-openjdk-17-slim AS build

WORKDIR /app

# Copy pom files
COPY pom.xml .
COPY synapse-core/pom.xml synapse-core/
COPY synapse-data/pom.xml synapse-data/
COPY synapse-security/pom.xml synapse-security/
COPY synapse-web/pom.xml synapse-web/

# Download dependencies
RUN mvn dependency:go-offline -B

# Copy source code
COPY synapse-core/src synapse-core/src
COPY synapse-data/src synapse-data/src
COPY synapse-security/src synapse-security/src
COPY synapse-web/src synapse-web/src

# Build application
RUN mvn clean package -DskipTests

# Runtime stage
FROM openjdk:17-jre-slim

WORKDIR /app

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Copy the built jar
COPY --from=build /app/synapse-web/target/synapse-web-*.jar app.jar

# Create non-root user
RUN groupadd -r synapse && useradd -r -g synapse synapse
RUN chown -R synapse:synapse /app
USER synapse

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/actuator/health || exit 1

# Run the application
ENTRYPOINT ["java", "-jar", "app.jar"]